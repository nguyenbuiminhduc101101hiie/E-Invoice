<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net"/>
  </configSections>
  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Logs/logfile.txt"/>
      <appendToFile value="true"/>
      <rollingStyle value="Size"/>
      <maxSizeRollBackups value="5"/>
      <maximumFileSize value="10MB"/>
      <staticLogFileName value="true"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date - %message%newline%exception"/>
      </layout>
    </appender>
    <root>
      <level value="ALL"/>
      <appender-ref ref="RollingFileAppender"/>
    </root>
  </log4net>
  <appSettings>
    <add key="ProxyIP" value="10.61.11.42"/>
    <add key="ProxyPort" value="3128"/>
    <add key="User" value="3604019464"/>
    <add key="Pass" value="Bn@12345678"/>
    <add key="APILink" value="https://api-vinvoice.viettel.vn"/>
    <add key="CodeTax" value="3604019464"/>
    <add key="SmtpServer" value="mail.logisticssoftware.vn"/>
    <add key="SmtpPort" value="587"/>
    <add key="SmtpUser" value="vms.noreply@logisticssoftware.vn"/>
    <add key="SmtpPassword" value="Noreply@1"/>
    <add key="FromEmail" value=""/>
    <add key="EnableSsl" value="true"/>
  </appSettings>
  <startup>
    
  <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>  
</configuration>
